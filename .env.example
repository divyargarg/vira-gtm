# Copy to .env and fill in. .env is gitignored — never commit real values.

# Path to the SQLite database (relative to the project root).
VIRA_DB_PATH=data/vira.db

# Folder where raw source exports (CSV/XLSX) are dropped for ingestion.
VIRA_RAW_DIR=data/raw

# --- Later stages (not used in Stage 1) ---
# HubSpot private app token for CRM sync (Stage 5).
HUBSPOT_ACCESS_TOKEN=
# Claude API key for personalization (Stage 4).
ANTHROPIC_API_KEY=
